- Comment complex algorithms
- Explain non-obvious decisions
- Document performance considerations
- Include references to algorithms or patterns

```language
// Using Fisher-Yates shuffle for unbiased random selection
// Time complexity: O(n), Space complexity: O(1)
function shuffleArray(array) {
    // Implementation
}

// Using memoization to cache expensive calculations
// Cache size limited to prevent memory issues
const memoizedCalculation = memoize(expensiveCalculation, 1000);
```

### 2. Section Comments
- Group related functions
- Document functional patterns
- Explain composition chains
- Document transformation pipelines

```language
// Data transformation pipeline
// 1. Filter invalid items
// 2. Transform to required format
// 3. Calculate aggregates
function processData(items) {
    return pipe(
        items,
        filterValidItems,    // Step 1
        transformItems,      // Step 2
        calculateTotals     // Step 3
    );
}
```

## Logging Standards

### 1. Function Logging
- Log function entry/exit
- Log important state changes
- Log error conditions
- Use appropriate log levels

```language
function processTransaction(transaction) {
    logger.debug('Processing transaction', { id: transaction.id });
    
    try {
        const result = validateAndProcess(transaction);
        logger.info('Transaction processed successfully', { 
            id: transaction.id,
            amount: transaction.amount 
        });
        return result;
    } catch (error) {
        logger.error('Transaction processing failed', {
            id: transaction.id,
            error: error.message
        });
        throw error;
    }
}
```

### 2. Performance Logging
- Log execution time
- Log memory usage
- Log cache hits/misses
- Log resource utilization

```language
function expensiveOperation(data) {
    const startTime = performance.now();
    logger.debug('Starting expensive operation', { 
        dataSize: data.length 
    });
    
    const result = processData(data);
    
    const duration = performance.now() - startTime;
    logger.info('Operation completed', {
        duration,
        resultSize: result.length
    });
    
    return result;
}
```

